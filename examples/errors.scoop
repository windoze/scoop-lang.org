import scoop.text.*

class ParseError(message: String) : Exception(Some(message))

fun parsePort(text: String): Int {
    val n = text.toIntOrNone() ?: throw ParseError(f"not a number: ${text}")
    if (n < 1 || n > 65535) throw ParseError(f"out of range: ${n}")
    return n
}

fun main() {
    for (input in ["8080", "http", "70000"]) {
        val result = try {
            f"port ${parsePort(input)}"
        } catch (e: ParseError) {
            f"error: ${e.message ?: "?"}"
        } finally {
            println(f"checked ${input}")
        }
        println(result)
    }
}
